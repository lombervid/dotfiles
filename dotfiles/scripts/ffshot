#!/usr/bin/env python
from pathlib import Path
from typing import Final
import argparse
import logging
import re
import subprocess

_DEFAULT_CONFIG: Final = {
    'screenshot_count': 6,
    'output_dir': 'screenshots',
}

class Console:
    __RESET = "\033[0m"
    __GREEN = "\033[32m"   # success
    __BLUE = "\033[34m"    # info
    __YELLOW = "\033[33m"  # warning
    __RED = "\033[31m"     # error
    __GRAY = "\033[90m"    # log

    def log(msg: str):
        print(f'{Console.__GRAY}{msg}{Console.__RESET}')

    def info(msg: str):
        print(f'{Console.__BLUE}{msg}{Console.__RESET}')

    def success(msg: str):
        print(f'{Console.__GREEN}{msg}{Console.__RESET}')

    def warning(msg: str):
        print(f'{Console.__YELLOW}{msg}{Console.__RESET}')

    def error(msg: str):
        print(f'{Console.__RED}{msg}{Console.__RESET}')

def get_video_duration(video: Path):
    """
    Get the duration of the video in seconds using ffprobe.

    Returns:
        int: Video duration in integer.
    """
    try:
        result = subprocess.run(
            ['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'default=noprint_wrappers=1:nokey=1', video],
            capture_output=True,
            text=True,
            check=True
        )
        duration = int(float(result.stdout.strip()))
        return duration
    except (subprocess.CalledProcessError, FileNotFoundError):
        Console.error(f'    ✗ Error: ffprobe is not installed or not in PATH.')
        return None
    except ValueError as e:
        Console.error(f'    ✗ Error: Could not parse video duration: {e}')
        return None

def take_video_screenshots(video: Path, num_screenshots: int, output: Path):
    """
    Take {num_screenshots} evenly spaced screenshots from a video using ffmpeg.

    Args:
        video (Path): Video file
        num_screenshots (int): Number of screenshots
        output (Path): Output directory
    """
    duration = get_video_duration(video)
    if not duration:
        return

    # Calculate timestamps for evenly spaced screenshots
    increment = int(duration / (num_screenshots + 1))
    timestamp = increment

    try:
        Console.info(f'    ● Taking {num_screenshots} screenshots...')
        # Create output directory
        output.mkdir(parents=True, exist_ok=True)

        for i in range(1, num_screenshots+1):
            Console.log(f'        ✓ Screenshot {i}/{num_screenshots}')
            output_path = output.joinpath(f'{video.name}_{timestamp:08d}.png')
            # Build ffmpeg command to extract single frame at timestamp
            ffmpeg_cmd = [
                'ffmpeg',
                '-y',
                '-loglevel', 'error',
                '-hide_banner',
                '-ss', f'{timestamp:.3f}',
                '-i', video,
                '-frames:v', '1',
                output_path
            ]
            subprocess.run(ffmpeg_cmd, check=True)
            timestamp += increment

        Console.success(f'    ✓ Successfully taken {num_screenshots} screenshots to "{output}" directory.')
    except subprocess.CalledProcessError as e:
        Console.error(f'    ✗ Error: ffmpeg command failed: {e}')

def _process_input_options(options):
    total_files = len(options['filenames'])
    Console.log(f'● {total_files} videos to process..')

    for file in options['filenames']:
        print(f'\n● Processing "{file.name}"')

        if not file.exists():
            Console.error(f'    ✗ Error: Video file not found.')
            continue

        output_dir = Path(options['output_dir'])
        # If there is more than 1 file, create a subdirectory with the filename
        if total_files > 1:
            output_dir = output_dir.joinpath(file.name)

        take_video_screenshots(file, options['screenshot_count'], output_dir)

def _get_ffmpeg_version() -> str | None:
    try:
        result = subprocess.run(['ffmpeg', '-version'], capture_output=True, text=True, timeout=5)

        if result.returncode != 0:
            return None

        # Parse first line for version
        first_line = result.stdout.split('\n')[0]
        version_match = re.search(r'version ([\d\.]+)', first_line)

        if not version_match:
            Console.error('✗ ffmpeg: unable to parse version')
            return None

        version = version_match.group(1)
        return version
    except FileNotFoundError as e:
        logging.error(e)
    except subprocess.TimeoutExpired as e:
        logging.error(e)

    return None

def _parse_parameters():
    parser = argparse.ArgumentParser(
        prog='ffshot',
        description='Take screenshots from a video file using ffmpeg and ffprobe',
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument('-n', '--count', type=int,
                        default=_DEFAULT_CONFIG['screenshot_count'],
                        help='number of screenshots', dest='screenshot_count')
    parser.add_argument('filenames', type=Path, help='Path(s) to the video file(s)', nargs='+')
    args = parser.parse_args()

    options = _DEFAULT_CONFIG.copy()
    options.update(vars(args))

    return options

def main():
    options = _parse_parameters()

    # Validate number of screenshots
    if options['screenshot_count'] <= 0:
        Console.error('✗ Error: Number of screenshots must be greater than 0')
        return

    # Check if ffmpeg is installed
    if ffmpeg_version := _get_ffmpeg_version():
        Console.success(f'✓ ffmpeg installed - Version: {ffmpeg_version}')
    else:
        Console.error('✗ ffmpeg not found or error occurred')
        return

    _process_input_options(options)

if __name__ == '__main__':
    main()
