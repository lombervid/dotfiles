#!/usr/bin/env python
from pathlib import Path
from typing import Final, TypedDict
import argparse
import logging
import os
import re
import subprocess
import sys

class DefaultOptions(TypedDict):
    screenshot_count: int
    output_dir: Path
    use_single_folder: bool
    quiet_output: bool

class ScreenshotSettings(TypedDict):
    force_8bits_color: bool
    force_sdr_mode: bool

class InputArguments(DefaultOptions, ScreenshotSettings):
    filenames: list[Path]

_DEFAULT_CONFIG: Final[DefaultOptions] = DefaultOptions(
    screenshot_count = 6,
    output_dir = 'screenshots',
    use_single_folder = False,
    quiet_output = False,
)

class Console:
    __RESET = '\033[0m'
    __NORMAL = '\x1b[38;20m'

    __COLORS: Final[dict[str, str]] = {
        'debug': '\033[90m', # grey
        'info': '\033[34m', # blue
        'success': '\033[32m', # green
        'warning': '\033[33m', # yellow
        'error': '\033[31m', # red
    }

    def print(msg: str, color: str = None):
        if not _DEFAULT_CONFIG['quiet_output']:
            return

        color = Console.__COLORS.get(color, Console.__NORMAL)
        print(f'{color}{msg}{Console.__RESET}')

    def debug(msg: str):
        Console.print(msg, 'debug')

    def info(msg: str):
        Console.print(msg, 'info')

    def success(msg: str):
        Console.print(msg, 'success')

    def warning(msg: str):
        Console.print(msg, 'warning')

    def error(msg: str):
        Console.print(msg, 'error')

def get_video_duration(video: Path):
    """
    Get the duration of the video in seconds using ffprobe.

    Returns:
        int: Video duration in integer.
    """
    try:
        result = subprocess.run(
            ['ffprobe', '-v', 'error', '-show_entries', 'format=duration', '-of', 'default=noprint_wrappers=1:nokey=1', video],
            capture_output=True,
            text=True,
            check=True
        )
        duration = int(float(result.stdout.strip()))
        return duration
    except (subprocess.CalledProcessError, FileNotFoundError):
        Console.error(f'    ✗ Error: ffprobe is not installed or not in PATH.')
    except ValueError as e:
        Console.error(f'    ✗ Error: Could not parse video duration: {e}')

    return None

def take_video_screenshots(video: Path, num_screenshots: int, output: Path, options: ScreenshotSettings):
    """
    Take {num_screenshots} evenly spaced screenshots from a video using ffmpeg.

    Args:
        video (Path): Video file
        num_screenshots (int): Number of screenshots
        output (Path): Output directory
    """
    duration = get_video_duration(video)
    if not duration:
        return

    output_name = ''
    ffmpeg_inputs: list = []
    ffmpeg_outputs: list = []
    ffmpeg_filters: list = []

    if options['force_sdr_mode']:
        output_name += '_sdr'
        ffmpeg_filters.extend(['-filter:v', 'libplacebo=tonemapping=spline:colorspace=bt709:color_primaries=bt709:color_trc=bt709:format=yuv420p'])

    if options['force_8bits_color']:
        output_name += '_8bit'
        ffmpeg_filters.extend(['-pix_fmt', 'rgb24'])
        output_name += '_8bit'

    # Calculate timestamps for evenly spaced screenshots
    increment = int(duration / (num_screenshots + 1))
    timestamp = increment

    try:
        Console.info(f'    ● Taking {num_screenshots} screenshots...')
        for i in range(0, num_screenshots):
            ffmpeg_inputs.extend(['-ss', f'{timestamp:.3f}', '-i', video])
            ffmpeg_outputs.extend([
                '-map', f'{i}:v',
                *ffmpeg_filters,
                '-frames:v', '1', '-update', '1',
                output.joinpath(f'{video.stem}-{timestamp:08d}{output_name}.png'),
            ])
            timestamp += increment

        # Create output directory
        output.mkdir(parents=True, exist_ok=True)

        # Build ffmpeg command to extract single frame at timestamp
        ffmpeg_cmd = [
            'ffmpeg',
            '-y',
            '-loglevel', 'time+level+error',
            '-hide_banner',
            *ffmpeg_inputs,
            *ffmpeg_outputs,
        ]
        subprocess.run(ffmpeg_cmd, check=True)

        Console.success(f'    ✓ Successfully saved to "{output.absolute()}" directory.')
    except subprocess.CalledProcessError as e:
        Console.error(f'    ✗ Error: ffmpeg command failed: {e}')
    except Exception as e:
        Console.error(f'    ✗ Error: {e}')

def _process_input_options(options: InputArguments):
    total_files = len(options['filenames'])
    Console.debug(f'● {total_files} videos to process..')

    for file in options['filenames']:
        Console.print(f'\n● Processing "{file.name}"')

        if not file.exists():
            Console.error(f'    ✗ Error: Video file not found.')
            continue

        output_dir = Path(os.path.expandvars(options['output_dir'])).expanduser()
        # If there is more than 1 file, create a subdirectory with the filename
        if total_files > 1 and not options['use_single_folder']:
            output_dir = output_dir.joinpath(file.name)

        take_video_screenshots(file, options['screenshot_count'], output_dir, options)

def _get_ffmpeg_version() -> str | None:
    try:
        result = subprocess.run(['ffmpeg', '-version'], capture_output=True, text=True, timeout=5)

        if result.returncode != 0:
            return None

        # Parse first line for version
        first_line = result.stdout.split('\n')[0]
        version_match = re.search(r'version ([a-z]?[\d\.]+)', first_line)

        if not version_match:
            Console.error('✗ ffmpeg: unable to parse version')
            return None

        version = version_match.group(1)
        return version
    except FileNotFoundError as e:
        logging.error(e)
    except subprocess.TimeoutExpired as e:
        logging.error(e)

    return None

def _parse_parameters() -> InputArguments:
    parser = argparse.ArgumentParser(
        prog='ffshot',
        description='Take screenshots from a video file using ffmpeg and ffprobe',
        formatter_class=argparse.ArgumentDefaultsHelpFormatter
    )
    parser.add_argument('-n', '--count', type=int,
                        default=_DEFAULT_CONFIG['screenshot_count'],
                        help='Number of screenshots', dest='screenshot_count')
    parser.add_argument('-sf', '--single-folder', action='store_true',
                        help='Save all the screenshots in the same folder when multiple files ares passed', dest='use_single_folder')
    parser.add_argument('-8bit', '--force-8bits-color', action='store_true', help='Force 8 bit color', dest='force_8bits_color')
    parser.add_argument('-hdr', '--force-hdr-to-sdr', action='store_true', help='Force HDR to SDR', dest='force_sdr_mode')
    parser.add_argument('-o', '--output-dir', type=Path, default=_DEFAULT_CONFIG['output_dir'], help='Directory to save the screenshots')
    parser.add_argument('-q', '--quiet', action='store_false', help='Disable progress output', dest='quiet_output')
    parser.add_argument('filenames', type=Path, help='Path(s) to the video file(s)', nargs='+')
    args = vars(parser.parse_args())

    _DEFAULT_CONFIG['quiet_output'] = args.pop('quiet_output', _DEFAULT_CONFIG['quiet_output'])
    options = InputArguments(args)
    return options

if __name__ == '__main__':
    options = _parse_parameters()

    # Validate number of screenshots
    if options['screenshot_count'] <= 0:
        Console.error('✗ Error: Number of screenshots must be greater than 0')
        sys.exit(1)

    # Check if ffmpeg is installed
    if ffmpeg_version := _get_ffmpeg_version():
        Console.success(f'✓ ffmpeg installed - Version: {ffmpeg_version}')
    else:
        Console.error('✗ ffmpeg not found or error occurred')
        sys.exit(1)

    _process_input_options(options)
